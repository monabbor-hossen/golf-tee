# ========================================================
# GolfTee Environment Configuration Template (Admin PHP)
# Copy from root .env.example or configure directly here.
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your production .env with live secrets to Git.
# ========================================================

# --------------------------------------------------------
# 1. Database Connection (Standard / Production)
# --------------------------------------------------------
DB_HOST=localhost
DB_NAME=golf_admin
DB_USER=golf_app_user
DB_PASS=CHANGE_ME_RUN_openssl_rand_base64_32
DB_CHARSET=utf8mb4

# --------------------------------------------------------
# 1b. Docker Compose Deployment Settings
# --------------------------------------------------------
# When deploying with Docker Compose, configure your environment as follows:
#   DB_HOST=db
#   DB_USER=golf_user
#   DB_PASS=${MYSQL_PASSWORD}
# Deployment sequence:
#   1. Copy template: cp .env.example .env
#   2. Generate secrets: run 'openssl rand -base64 32' for passwords and 'openssl rand -base64 48' for session secret
#   3. Start containers: docker-compose up -d
#   4. Initialize database: import schema.sql then seed.sql (pre-mounted in docker-entrypoint-initdb.d)
MYSQL_ROOT_PASSWORD=CHANGE_ME_RUN_openssl_rand_base64_32
MYSQL_PASSWORD=CHANGE_ME_RUN_openssl_rand_base64_32

# --------------------------------------------------------
# 2. Application Settings
# --------------------------------------------------------
APP_NAME="Pine Valley Golf Club"
APP_URL=http://localhost/golf-tee/admin-php
# MANDATORY: Running 'openssl rand -base64 48' is mandatory, not optional. Minimum 64 characters required.
# Generate with: openssl rand -base64 48 (produces 64 chars)
SESSION_SECRET=CHANGE_ME_RUN_openssl_rand_base64_48

# --------------------------------------------------------
# 3. SMTP Mail Configuration (Optional)
# --------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-club-email@gmail.com
# Generate at https://myaccount.google.com/apppasswords
MAIL_PASSWORD=CHANGE_ME_GOOGLE_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-club-email@gmail.com
MAIL_FROM_NAME="Pine Valley Golf Club"

# --------------------------------------------------------
# 4. Marketplace & Demo Configuration (Optional)
# --------------------------------------------------------
ENABLE_VIBE96_DEMO=false
