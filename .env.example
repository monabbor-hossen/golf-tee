# ========================================================
# GolfTee Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your production .env with live secrets to Git.
# ========================================================

# --------------------------------------------------------
# 1. Database Connection
# --------------------------------------------------------
# The host address of your MySQL database server (e.g. localhost, 127.0.0.1, or db)
DB_HOST=localhost

# The name of the MySQL database for GolfTee
DB_NAME=golf_admin

# The MySQL username with full privileges on the database above
DB_USER=root

# The MySQL password for the user above (leave blank for default local XAMPP)
DB_PASS=

# Database character set (utf8mb4 is required for international characters & emojis)
DB_CHARSET=utf8mb4

# Docker MySQL Credentials (Required if deploying with Docker Compose)
# Notice: Buyers MUST run 'openssl rand -base64 32' for both MYSQL_ROOT_PASSWORD and MYSQL_PASSWORD before first deployment.
# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_RUN_openssl_rand_base64_32
MYSQL_PASSWORD=CHANGE_ME_RUN_openssl_rand_base64_32

# --------------------------------------------------------
# 2. Application Settings
# --------------------------------------------------------
# The public-facing name of your golf club or country club
APP_NAME="Pine Valley Golf Club"

# The full canonical URL pointing to your admin-php root directory (without trailing slash)
# For local XAMPP: http://localhost/golf-tee/admin-php
# For production:  https://your-domain.com/admin-php (or https://api.yourdomain.com)
APP_URL=http://localhost/golf-tee/admin-php

# MANDATORY: Running 'openssl rand -base64 48' is mandatory, not optional. Minimum 64 characters required.
# Generate with: openssl rand -base64 48 (produces 64 chars)
SESSION_SECRET=CHANGE_ME_RUN_openssl_rand_base64_48

# --------------------------------------------------------
# 3. SMTP Mail Configuration (Optional)
# Used for sending member invitation links and password setup emails.
# --------------------------------------------------------
# SMTP host server (e.g. smtp.gmail.com, smtp.sendgrid.net, mail.yourdomain.com)
MAIL_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
MAIL_PORT=587

# SMTP account username (usually your full email address)
MAIL_USERNAME=your-club-email@gmail.com

# SMTP account password (Generate at https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=CHANGE_ME_GOOGLE_APP_PASSWORD

# Encryption method: tls or ssl
MAIL_ENCRYPTION=tls

# The default "From" email address displayed to recipients
MAIL_FROM_ADDRESS=your-club-email@gmail.com

# The default sender name displayed in email inboxes
MAIL_FROM_NAME="Pine Valley Golf Club"

# --------------------------------------------------------
# 4. Marketplace & Demo Configuration (Optional)
# --------------------------------------------------------
# Set to true when hosting a live interactive preview for Vibe96 marketplace
ENABLE_VIBE96_DEMO=false
